{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zero to Shipped",
  "version": "0.1.0",
  "identifier": "com.therayally.zerotoshipped",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5175 --strictPort",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zero to Shipped",
        "width": 1380,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://zerotoshipped-ruddy.vercel.app http://localhost:8787; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Learn to build, launch and secure an app with AI",
    "copyright": "\u00a9 2026 The Ray Ally",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
